<Project>
  <!--
    CI only. The Examples workflow sets the environment variable CustomAfterMicrosoftCommonTargets to this
    file's path, and MSBuild then imports it into every project that job builds. Nothing in the repository
    imports it, so a normal build, and every folder people copy, is unchanged.

    It compiles CiHost.cs into the programs (the examples and the projects made from README.md), never into
    the library or the unit tests. CiHost.cs deletes the files each program uploads or gets back, when the
    program exits.
  -->
  <ItemGroup Condition="'$(OutputType)' == 'Exe' and '$(IsTestProject)' != 'true' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <Compile Include="$(MSBuildThisFileDirectory)CiHost.cs" Link="ci/CiHost.cs" Visible="false" />
  </ItemGroup>
</Project>
